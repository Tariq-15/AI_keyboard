<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 11-and-below counterpart to data_extraction_rules.xml.

  `allowBackup="false"` already stops backup on these versions, so this file changes
  nothing on its own. It is here so the answer is written down in both places rather
  than depending on one attribute being read correctly: nothing this app stores is
  eligible for backup, and an empty ruleset says so explicitly.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
