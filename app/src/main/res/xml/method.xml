<?xml version="1.0" encoding="utf-8"?>
<!--
  Subtype list. Adding a language later is purely additive: append another
  <subtype> element with its own locale and keyboard layout label.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.chalkboard.keyboard.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <subtype
        android:label="@string/subtype_en"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=qwerty" />
</input-method>
